# Publieke Supabase-instellingen. Deze waarden identificeren het project, maar
# geven nooit beheerrechten. Kopieer dit bestand naar .env.local.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<lokale-publishable-key-uit-supabase-status>
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Alleen server-side gebruiken. Nooit prefixen met NEXT_PUBLIC_ en nooit committen.
SUPABASE_SERVICE_ROLE_KEY=<lokale-service-role-key-uit-supabase-status>

# Pas vanaf de e-mailfase nodig.
RESEND_API_KEY=<later-instellen>
RESEND_FROM_EMAIL=<later-instellen>

# HMAC-geheim voor privacyvriendelijke rate-limit identifiers.
REQUEST_FINGERPRINT_SECRET=<minimaal-32-willekeurige-tekens>
