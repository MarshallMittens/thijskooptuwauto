# Publieke Supabase-instellingen. Deze waarden identificeren het project, maar
# geven nooit beheerrechten. Kopieer dit bestand naar .env.local.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54521
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<lokale-publishable-key-uit-supabase-status>

# Publieke origin van de app, uitsluitend server-side gebruikt voor auth-links.
APP_URL=http://127.0.0.1:3000

# Alleen server-side gebruiken. Nooit prefixen met NEXT_PUBLIC_ en nooit committen.
SUPABASE_SERVICE_ROLE_KEY=<lokale-service-role-key-uit-supabase-status>

# Minimaal 32 willekeurige tekens; gebruik een andere waarde per omgeving.
DRAFT_TOKEN_SECRET=<minimaal-32-willekeurige-tekens>

# Pas vanaf de e-mailfase nodig.
RESEND_API_KEY=
# Optionele overschrijving; standaard gebruikt de app onderstaande afzender.
RESEND_FROM_EMAIL="Thijskooptuwauto <info@thijskooptuwauto.nl>"

# HMAC-geheim voor privacyvriendelijke rate-limit identifiers.
REQUEST_FINGERPRINT_SECRET=<minimaal-32-willekeurige-tekens>

# Optioneel. Publieke RDW-data werkt zonder token; een token kan ruimere limieten geven.
RDW_APP_TOKEN=

# Uitsluitend voor de lokale fase-5-simulator. Laat uit/false buiten lokale tests.
# De applicatie weigert deze simulator in een productie-runtime.
PAYMENT_SIMULATOR_ENABLED=false
PAYMENT_SIMULATOR_WEBHOOK_SECRET=<afzonderlijk-lokaal-geheim-van-minimaal-32-tekens>

# Fase 6: geheime server-naar-serverwaarde voor operationele taken.
# Bezorging blijft standaard uit; zet pas aan na verificatie van afzender en sjablonen.
OPERATIONS_JOB_SECRET=<afzonderlijk-geheim-van-minimaal-32-tekens>
OUTBOX_DELIVERY_ENABLED=false

# Extra veiligheidspoort. Laat false voor lokale en Preview-omgevingen.
# Productie mag pas na de volledige livegangcontrole expliciet true krijgen.
PRODUCTION_DEPLOYMENT_APPROVED=false
